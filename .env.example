# =============================================================
# LincolnNavigation.com — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; never
# commit real keys. For production, set these in your host's
# environment (e.g. Vercel → Settings → Environment Variables).
#
# NEXT_PUBLIC_* values are exposed to the browser — only put
# non-secret values there. Everything else is server-only.
# =============================================================

# ---------------------------------------------------------------
# Maps & routing
# ---------------------------------------------------------------

# MapLibre vector style URL. Defaults to OpenFreeMap Liberty.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Self-hosted routing / geocoding backends (optional — public
# fallbacks are used when unset).
VALHALLA_URL=
NEXT_PUBLIC_OSRM_URL=
NOMINATIM_URL=

# Optional third-party routing / places providers (all optional —
# each unlocks a better data source when its key is present).
ORS_API_KEY=
GRAPHHOPPER_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Lincoln Navigation

# Public site origin — used for Paystack redirect URLs and similar.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------
# Monetization  (see docs/MONETIZATION.md — each stream stays OFF
# until its variables are set)
# ---------------------------------------------------------------

# --- Display ads: Google AdSense ---
# Publisher id, "ca-pub-XXXXXXXXXXXXXXXX".
NEXT_PUBLIC_ADSENSE_CLIENT=
# Numeric slot ids for the two display units created in AdSense.
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_PLACES=
# Set to 1 to show placeholder boxes for unconfigured ad slots in dev.
NEXT_PUBLIC_ADS_DEBUG=

# --- Premium plan: Paystack ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Signs the premium entitlement cookie. Generate: openssl rand -hex 32
PREMIUM_COOKIE_SECRET=
# Optional price overrides. Default: GHS 30.00 / month (100 pesewas = GHS 1).
NEXT_PUBLIC_PREMIUM_PRICE_PESEWAS=
NEXT_PUBLIC_PREMIUM_CURRENCY=

# --- Advertising / sponsorship ---
# Where /advertise enquiries are sent.
NEXT_PUBLIC_ADVERTISE_EMAIL=
# Set to "off" to hide the house promo in the Explore Nearby panel.
NEXT_PUBLIC_HOUSE_PROMO=
